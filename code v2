blueprint:
  name: Company EV Home Charging Reimbursement V2
  description: >
    Track the electricity cost of charging a company EV at home using an
    ecoMain power sensor.

    V2 improvements:
    - Prevents overlapping charging-cost sessions
    - Uses elapsed-time integration instead of interval-end sampling
    - Handles unavailable sensor states safely
    - Supports W / kW power sensors
    - Supports EUR/kWh and EUR/MWh dynamic price sensors
    - Avoids repeated rounding during accumulation
    - Provides reliable monthly rollover using a billing-month helper

    Supports:
    - Fixed electricity price
    - Compatible dynamic electricity price sensors such as Nord Pool
    - Automatic charging-session detection
    - Automatic monthly reimbursement accumulation
    - Automatic monthly rollover

    Required helpers:
    1. Number Helper:
       Company EV Monthly Reimbursement

    2. Text Helper:
       Company EV Reimbursement Billing Month

  domain: automation

  input:

    ev_power_sensor:
      name: EV Charging Power Sensor
      description: >
        Select the ecoMain real-time power sensor for the dedicated
        EV charging circuit.
      selector:
        entity:
          domain: sensor
          device_class: power

    pricing_mode:
      name: Electricity Pricing Method
      description: >
        Choose a manually entered fixed electricity price or a compatible
        dynamic electricity price sensor.
      default: fixed
      selector:
        select:
          options:
            - label: Fixed Price
              value: fixed
            - label: Dynamic Price / Nord Pool
              value: dynamic

    fixed_price:
      name: Fixed Electricity Price
      description: >
        Electricity price in EUR/kWh.
        Used only when Fixed Price is selected.
      default: 0.30
      selector:
        number:
          min: 0
          max: 5
          step: 0.001
          mode: box
          unit_of_measurement: "EUR/kWh"

    dynamic_price_sensor:
      name: Dynamic Electricity Price Sensor
      description: >
        Used only in Dynamic Price mode.

        Supported units:
        EUR/kWh
        €/kWh
        EUR/MWh
        €/MWh
      default: ""
      selector:
        entity:
          domain: sensor

    reimbursement_output:
      name: Monthly Reimbursement Output
      description: >
        Number Helper used to store the current month's accumulated
        company EV charging reimbursement.

        The helper must allow 0 and should have a sufficiently large
        maximum value.
      selector:
        entity:
          domain: input_number

    billing_month_output:
      name: Billing Month Helper
      description: >
        Text Helper used internally to remember which month the current
        reimbursement belongs to.

        Example state:
        2026-08
      selector:
        entity:
          domain: input_text

    charging_threshold:
      name: Charging Power Threshold
      description: >
        A charging session begins after the selected circuit remains
        above this power level for the confirmation period.

        The session ends when valid measured power falls to or below
        this level.
      default: 500
      selector:
        number:
          min: 10
          max: 22000
          step: 10
          mode: box
          unit_of_measurement: W

    start_confirmation:
      name: Charging Start Confirmation
      description: >
        How long the charging power must remain above the threshold
        before a charging session starts.
      default:
        minutes: 2
      selector:
        duration:

    calculation_interval:
      name: Maximum Calculation Interval
      description: >
        Maximum time between cost updates.

        Power or dynamic-price changes can trigger an earlier update,
        allowing the calculation to use the actual elapsed time between
        samples.
      default: 1
      selector:
        number:
          min: 1
          max: 15
          step: 1
          mode: box
          unit_of_measurement: min


variables:

  power_entity: !input ev_power_sensor
  pricing_mode_var: !input pricing_mode
  fixed_price_var: !input fixed_price
  dynamic_price_entity: !input dynamic_price_sensor

  reimbursement_entity: !input reimbursement_output
  billing_month_entity: !input billing_month_output

  charging_threshold_w: !input charging_threshold
  interval_minutes: !input calculation_interval


triggers:

  # ------------------------------------------------------------
  # Charging session start
  # ------------------------------------------------------------
  - trigger: numeric_state
    entity_id: !input ev_power_sensor
    above: !input charging_threshold
    for: !input start_confirmation
    id: charging_start

  # ------------------------------------------------------------
  # Normal monthly rollover
  # ------------------------------------------------------------
  - trigger: time
    at: "00:00:00"
    id: daily_midnight

  # ------------------------------------------------------------
  # Catch missed monthly rollover after HA restart
  # ------------------------------------------------------------
  - trigger: homeassistant
    event: start
    id: homeassistant_start


conditions: []


actions:

  - choose:

      # ========================================================
      # MONTHLY ROLLOVER / RECOVERY
      # ========================================================
      - conditions:
          - condition: template
            value_template: >
              {{
                trigger.id in ['daily_midnight', 'homeassistant_start']
              }}

        sequence:

          - variables:
              current_month: "{{ now().strftime('%Y-%m') }}"
              stored_month: "{{ states(billing_month_entity) }}"

              helper_min: >
                {{
                  state_attr(reimbursement_entity, 'min')
                  | float(0)
                }}

              helper_max: >
                {{
                  state_attr(reimbursement_entity, 'max')
                  | float(0)
                }}

          - if:
              - condition: template
                value_template: >
                  {{
                    helper_min > 0
                    or helper_max <= 0
                  }}
            then:
              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Reimbursement helper configuration error.
                    The helper must allow a value of 0.

              - stop: >
                  Monthly reimbursement helper does not allow zero.
                error: true

          - if:
              - condition: template
                value_template: >
                  {{
                    stored_month != current_month
                  }}
            then:

              - action: input_number.set_value
                target:
                  entity_id: !input reimbursement_output
                data:
                  value: 0

              - action: input_text.set_value
                target:
                  entity_id: !input billing_month_output
                data:
                  value: "{{ current_month }}"

              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Monthly EV reimbursement started for
                    {{ current_month }}.


      # ========================================================
      # CHARGING SESSION
      # ========================================================
      - conditions:
          - condition: trigger
            id:
              - charging_start

        sequence:

          # ----------------------------------------------------
          # Validate helper configuration
          # ----------------------------------------------------
          - variables:

              helper_min: >
                {{
                  state_attr(reimbursement_entity, 'min')
                  | float(0)
                }}

              helper_max: >
                {{
                  state_attr(reimbursement_entity, 'max')
                  | float(0)
                }}

              current_month: "{{ now().strftime('%Y-%m') }}"
              stored_month: "{{ states(billing_month_entity) }}"

          - if:
              - condition: template
                value_template: >
                  {{
                    helper_min > 0
                    or helper_max <= 0
                  }}
            then:

              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Reimbursement helper configuration error.
                    It must allow zero and have a positive maximum.

              - stop: Invalid reimbursement helper range.
                error: true


          # ----------------------------------------------------
          # Recover monthly rollover if needed
          # ----------------------------------------------------
          - if:
              - condition: template
                value_template: >
                  {{
                    stored_month != current_month
                  }}
            then:

              - action: input_number.set_value
                target:
                  entity_id: !input reimbursement_output
                data:
                  value: 0

              - action: input_text.set_value
                target:
                  entity_id: !input billing_month_output
                data:
                  value: "{{ current_month }}"


          # ----------------------------------------------------
          # Initial sensor validation
          # ----------------------------------------------------
          - variables:

              initial_power_state: "{{ states(power_entity) }}"
              power_unit: >
                {{
                  state_attr(
                    power_entity,
                    'unit_of_measurement'
                  ) or ''
                }}

              initial_power_kw: >
                {% set s = states(power_entity) %}

                {% if not is_number(s) %}

                  -1

                {% elif power_unit == 'W' %}

                  {{ (s | float) / 1000 }}

                {% elif power_unit == 'kW' %}

                  {{ s | float }}

                {% else %}

                  -1

                {% endif %}

              initial_price_state: >
                {% if pricing_mode_var == 'dynamic' %}
                  {{ states(dynamic_price_entity) }}
                {% else %}
                  {{ fixed_price_var }}
                {% endif %}

              initial_price_unit: >
                {% if pricing_mode_var == 'dynamic' %}

                  {{
                    state_attr(
                      dynamic_price_entity,
                      'unit_of_measurement'
                    ) or ''
                  }}

                {% else %}

                  EUR/kWh

                {% endif %}

              initial_price_eur_kwh: >
                {% if pricing_mode_var == 'fixed' %}

                  {{ fixed_price_var | float }}

                {% elif not is_number(
                    states(dynamic_price_entity)
                  ) %}

                  -1

                {% elif initial_price_unit
                    in ['EUR/kWh', '€/kWh'] %}

                  {{
                    states(dynamic_price_entity)
                    | float
                  }}

                {% elif initial_price_unit
                    in ['EUR/MWh', '€/MWh'] %}

                  {{
                    (
                      states(dynamic_price_entity)
                      | float
                    ) / 1000
                  }}

                {% else %}

                  -1

                {% endif %}

          - if:
              - condition: template
                value_template: >
                  {{
                    initial_power_kw < 0
                    or initial_price_eur_kwh < 0
                  }}
            then:

              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Charging session was not started because
                    the selected power or price sensor has an
                    unavailable, non-numeric, or unsupported unit.

              - stop: Invalid power or price sensor state.
                error: false


          # ----------------------------------------------------
          # Initialize integration sample
          # ----------------------------------------------------
          - variables:

              last_sample_ts: "{{ as_timestamp(now()) }}"

              last_power_state: >
                {{ states(power_entity) }}

              last_power_kw: >
                {{ initial_power_kw | float }}

              last_price_state: >
                {% if pricing_mode_var == 'dynamic' %}
                  {{ states(dynamic_price_entity) }}
                {% else %}
                  fixed
                {% endif %}

              last_price_eur_kwh: >
                {{ initial_price_eur_kwh | float }}

              active_billing_month: >
                {{ now().strftime('%Y-%m') }}


          # ====================================================
          # HIGH-PRECISION SESSION INTEGRATION LOOP
          # ====================================================
          - repeat:

              sequence:

                # ------------------------------------------------
                # Wake up when:
                # - power changes
                # - dynamic price changes
                # - maximum update interval expires
                # ------------------------------------------------
                - wait_template: >
                    {{
                      states(power_entity)
                      != last_power_state

                      or

                      (
                        pricing_mode_var == 'dynamic'
                        and
                        states(dynamic_price_entity)
                        != last_price_state
                      )
                    }}

                  timeout:
                    minutes: !input calculation_interval

                  continue_on_timeout: true


                - variables:

                    now_ts: "{{ as_timestamp(now()) }}"

                    elapsed_hours: >
                      {{
                        [
                          (
                            (
                              as_timestamp(now())
                              -
                              (last_sample_ts | float)
                            ) / 3600
                          ),
                          0
                        ]
                        | max
                      }}


                    # --------------------------------------------
                    # Current power
                    # --------------------------------------------
                    current_power_state: >
                      {{ states(power_entity) }}

                    current_power_unit: >
                      {{
                        state_attr(
                          power_entity,
                          'unit_of_measurement'
                        ) or ''
                      }}

                    current_power_kw: >
                      {% set s = states(power_entity) %}

                      {% if not is_number(s) %}

                        -1

                      {% elif current_power_unit == 'W' %}

                        {{ (s | float) / 1000 }}

                      {% elif current_power_unit == 'kW' %}

                        {{ s | float }}

                      {% else %}

                        -1

                      {% endif %}


                    # --------------------------------------------
                    # Current electricity price
                    # --------------------------------------------
                    current_price_state: >
                      {% if pricing_mode_var == 'dynamic' %}
                        {{ states(dynamic_price_entity) }}
                      {% else %}
                        fixed
                      {% endif %}

                    current_price_unit: >
                      {% if pricing_mode_var == 'dynamic' %}

                        {{
                          state_attr(
                            dynamic_price_entity,
                            'unit_of_measurement'
                          ) or ''
                        }}

                      {% else %}

                        EUR/kWh

                      {% endif %}

                    current_price_eur_kwh: >
                      {% if pricing_mode_var == 'fixed' %}

                        {{ fixed_price_var | float }}

                      {% elif not is_number(
                          states(dynamic_price_entity)
                        ) %}

                        -1

                      {% elif current_price_unit
                          in ['EUR/kWh', '€/kWh'] %}

                        {{
                          states(dynamic_price_entity)
                          | float
                        }}

                      {% elif current_price_unit
                          in ['EUR/MWh', '€/MWh'] %}

                        {{
                          (
                            states(dynamic_price_entity)
                            | float
                          ) / 1000
                        }}

                      {% else %}

                        -1

                      {% endif %}


                    # --------------------------------------------
                    # Integrate the PREVIOUS valid sample across
                    # the actual elapsed time.
                    # --------------------------------------------
                    interval_cost: >
                      {% if
                        (last_power_kw | float(-1)) >= 0
                        and
                        (last_price_eur_kwh | float(-1)) >= 0
                      %}

                        {{
                          (last_power_kw | float)
                          *
                          (last_price_eur_kwh | float)
                          *
                          (elapsed_hours | float)
                        }}

                      {% else %}

                        0

                      {% endif %}


                    existing_reimbursement: >
                      {{
                        states(reimbursement_entity)
                        | float(0)
                      }}

                    proposed_reimbursement: >
                      {{
                        (existing_reimbursement | float)
                        +
                        (interval_cost | float)
                      }}

                    current_month: >
                      {{ now().strftime('%Y-%m') }}


                # ------------------------------------------------
                # Handle month rollover DURING an active session
                # ------------------------------------------------
                - if:

                    - condition: template
                      value_template: >
                        {{
                          current_month
                          != active_billing_month
                        }}

                  then:

                    - action: input_number.set_value
                      target:
                        entity_id: !input reimbursement_output
                      data:
                        value: 0

                    - action: input_text.set_value
                      target:
                        entity_id: !input billing_month_output
                      data:
                        value: "{{ current_month }}"

                    - variables:
                        existing_reimbursement: 0
                        proposed_reimbursement: >
                          {{ interval_cost | float }}

                        active_billing_month: >
                          {{ current_month }}


                # ------------------------------------------------
                # Validate helper maximum BEFORE writing
                # ------------------------------------------------
                - if:

                    - condition: template
                      value_template: >
                        {{
                          (proposed_reimbursement | float)
                          >
                          (
                            state_attr(
                              reimbursement_entity,
                              'max'
                            )
                            | float(0)
                          )
                        }}

                  then:

                    - action: logbook.log
                      data:
                        name: Company EV Home Charging
                        message: >
                          Reimbursement helper maximum reached.
                          Increase the helper maximum before
                          continuing accumulation.

                    - stop: >
                        Reimbursement output maximum exceeded.
                      error: true


                # ------------------------------------------------
                # Write only when the previous sample was valid
                # ------------------------------------------------
                - if:

                    - condition: template
                      value_template: >
                        {{
                          (last_power_kw | float(-1)) >= 0
                          and
                          (last_price_eur_kwh | float(-1)) >= 0
                          and
                          (interval_cost | float) > 0
                        }}

                  then:

                    - action: input_number.set_value
                      target:
                        entity_id: !input reimbursement_output
                      data:
                        value: >
                          {{
                            proposed_reimbursement
                            | float
                          }}


                # ------------------------------------------------
                # Update integration sample
                #
                # Invalid states are preserved as invalid (-1);
                # they are NOT converted to zero.
                # ------------------------------------------------
                - variables:

                    last_sample_ts: >
                      {{ now_ts | float }}

                    last_power_state: >
                      {{ current_power_state }}

                    last_power_kw: >
                      {{ current_power_kw | float(-1) }}

                    last_price_state: >
                      {{ current_price_state }}

                    last_price_eur_kwh: >
                      {{
                        current_price_eur_kwh
                        | float(-1)
                      }}


              # --------------------------------------------------
              # End only when a VALID power reading is at or
              # below the charging threshold.
              #
              # unavailable / unknown does not end the session.
              # --------------------------------------------------
              until:

                - condition: template
                  value_template: >
                    {% set s = states(power_entity) %}

                    {% if not is_number(s) %}

                      false

                    {% else %}

                      {% set unit =
                        state_attr(
                          power_entity,
                          'unit_of_measurement'
                        ) or ''
                      %}

                      {% if unit == 'W' %}

                        {{
                          (s | float)
                          <=
                          (charging_threshold_w | float)
                        }}

                      {% elif unit == 'kW' %}

                        {{
                          ((s | float) * 1000)
                          <=
                          (charging_threshold_w | float)
                        }}

                      {% else %}

                        false

                      {% endif %}

                    {% endif %}


          - action: logbook.log
            data:
              name: Company EV Home Charging
              message: >
                Charging session finished.
                Current monthly reimbursement:
                €{{
                  states(reimbursement_entity)
                  | float(0)
                  | round(2)
                }}.


# Prevent overlapping charging sessions.
#
# If another charging-start trigger appears while the current
# session is still active, it is ignored rather than creating a
# second cost-writing loop.
#
# Monthly rollover during an active session is handled inside
# the session loop itself.
mode: single
max_exceeded: silent
