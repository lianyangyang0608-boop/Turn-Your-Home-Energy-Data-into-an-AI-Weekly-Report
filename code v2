blueprint:
  name: Company EV Home Charging Reimbursement V2
  description: >
    Track company EV home-charging costs using an ecoMain power sensor.

    Supports fixed or dynamic electricity pricing, automatic charging-session
    detection, monthly reimbursement accumulation, and monthly rollover.

    Required helpers:
    1. Number Helper: Company EV Monthly Reimbursement
    2. Text Helper: Company EV Reimbursement Billing Month

  domain: automation

  input:
    ev_power_sensor:
      name: EV Charging Power Sensor
      description: Select the ecoMain real-time power sensor for the EV charging circuit.
      selector:
        entity:
          domain: sensor
          device_class: power

    pricing_mode:
      name: Electricity Pricing Method
      default: fixed
      selector:
        select:
          options:
            - label: Fixed Price
              value: fixed
            - label: Dynamic Price / Nord Pool
              value: dynamic

    fixed_price:
      name: Fixed Electricity Price
      description: Used only when Fixed Price is selected.
      default: 0.30
      selector:
        number:
          min: 0
          max: 5
          step: 0.001
          mode: box
          unit_of_measurement: "EUR/kWh"

    dynamic_price_sensor:
      name: Dynamic Electricity Price Sensor
      description: >
        Used only in Dynamic Price mode.
        Supported units: EUR/kWh, €/kWh, EUR/MWh, €/MWh.
      default: ""
      selector:
        entity:
          domain: sensor

    reimbursement_output:
      name: Monthly Reimbursement Output
      description: >
        Number Helper used to store the current month's accumulated charging cost.
        It must allow a value of 0.
      selector:
        entity:
          domain: input_number

    billing_month_output:
      name: Billing Month Helper
      description: >
        Text Helper used internally to store the active billing month in YYYY-MM format.
      selector:
        entity:
          domain: input_text

    charging_threshold:
      name: Charging Power Threshold
      default: 500
      selector:
        number:
          min: 10
          max: 22000
          step: 10
          mode: box
          unit_of_measurement: W

    start_confirmation:
      name: Charging Start Confirmation
      description: >
        How long charging power must remain above the threshold before the session starts.
      default:
        minutes: 2
      selector:
        duration:

    calculation_interval:
      name: Maximum Calculation Interval
      description: Maximum time between cost updates.
      default: 1
      selector:
        number:
          min: 1
          max: 15
          step: 1
          mode: box
          unit_of_measurement: min


variables:
  power_entity: !input ev_power_sensor
  pricing_mode_var: !input pricing_mode
  fixed_price_var: !input fixed_price
  dynamic_price_entity: !input dynamic_price_sensor
  reimbursement_entity: !input reimbursement_output
  billing_month_entity: !input billing_month_output
  charging_threshold_w: !input charging_threshold
  interval_minutes: !input calculation_interval


triggers:
  - trigger: numeric_state
    entity_id: !input ev_power_sensor
    above: !input charging_threshold
    for: !input start_confirmation
    id: charging_start

  - trigger: time
    at: "00:00:00"
    id: daily_midnight

  - trigger: homeassistant
    event: start
    id: homeassistant_start


conditions: []


actions:
  - choose:

      # Monthly rollover / recovery
      - conditions:
          - condition: template
            value_template: >
              {{ trigger.id in ['daily_midnight', 'homeassistant_start'] }}

        sequence:
          - variables:
              current_month: "{{ now().strftime('%Y-%m') }}"
              stored_month: "{{ states(billing_month_entity) }}"
              helper_min: >
                {{ state_attr(reimbursement_entity, 'min') | float(0) }}
              helper_max: >
                {{ state_attr(reimbursement_entity, 'max') | float(0) }}

          - if:
              - condition: template
                value_template: >
                  {{ helper_min > 0 or helper_max <= 0 }}
            then:
              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Invalid reimbursement helper configuration.
                    The helper must allow 0 and have a positive maximum.

              - stop: Invalid reimbursement helper range.
                error: true

          - if:
              - condition: template
                value_template: >
                  {{ stored_month != current_month }}
            then:
              - action: input_number.set_value
                target:
                  entity_id: !input reimbursement_output
                data:
                  value: 0

              - action: input_text.set_value
                target:
                  entity_id: !input billing_month_output
                data:
                  value: "{{ current_month }}"

              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Monthly EV reimbursement started for {{ current_month }}.


      # Charging session
      - conditions:
          - condition: trigger
            id:
              - charging_start

        sequence:
          - variables:
              helper_min: >
                {{ state_attr(reimbursement_entity, 'min') | float(0) }}
              helper_max: >
                {{ state_attr(reimbursement_entity, 'max') | float(0) }}
              current_month: "{{ now().strftime('%Y-%m') }}"
              stored_month: "{{ states(billing_month_entity) }}"

          - if:
              - condition: template
                value_template: >
                  {{ helper_min > 0 or helper_max <= 0 }}
            then:
              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Invalid reimbursement helper configuration.
                    It must allow 0 and have a positive maximum.

              - stop: Invalid reimbursement helper range.
                error: true

          - if:
              - condition: template
                value_template: >
                  {{ stored_month != current_month }}
            then:
              - action: input_number.set_value
                target:
                  entity_id: !input reimbursement_output
                data:
                  value: 0

              - action: input_text.set_value
                target:
                  entity_id: !input billing_month_output
                data:
                  value: "{{ current_month }}"

          - variables:
              power_unit: >
                {{ state_attr(power_entity, 'unit_of_measurement') or '' }}

              initial_power_kw: >
                {% set s = states(power_entity) %}
                {% if not is_number(s) %}
                  -1
                {% elif power_unit == 'W' %}
                  {{ (s | float) / 1000 }}
                {% elif power_unit == 'kW' %}
                  {{ s | float }}
                {% else %}
                  -1
                {% endif %}

              initial_price_unit: >
                {% if pricing_mode_var == 'dynamic' %}
                  {{ state_attr(dynamic_price_entity, 'unit_of_measurement') or '' }}
                {% else %}
                  EUR/kWh
                {% endif %}

              initial_price_eur_kwh: >
                {% if pricing_mode_var == 'fixed' %}
                  {{ fixed_price_var | float }}
                {% elif not is_number(states(dynamic_price_entity)) %}
                  -1
                {% elif initial_price_unit in ['EUR/kWh', '€/kWh'] %}
                  {{ states(dynamic_price_entity) | float }}
                {% elif initial_price_unit in ['EUR/MWh', '€/MWh'] %}
                  {{ (states(dynamic_price_entity) | float) / 1000 }}
                {% else %}
                  -1
                {% endif %}

          - if:
              - condition: template
                value_template: >
                  {{ initial_power_kw < 0 or initial_price_eur_kwh < 0 }}
            then:
              - action: logbook.log
                data:
                  name: Company EV Home Charging
                  message: >
                    Charging session was not started because the power or
                    price sensor is unavailable or uses an unsupported unit.

              - stop: Invalid power or price sensor state.
                error: false

          - variables:
              last_sample_ts: "{{ as_timestamp(now()) }}"
              last_power_state: "{{ states(power_entity) }}"
              last_power_kw: "{{ initial_power_kw | float }}"
              last_price_state: >
                {% if pricing_mode_var == 'dynamic' %}
                  {{ states(dynamic_price_entity) }}
                {% else %}
                  fixed
                {% endif %}
              last_price_eur_kwh: "{{ initial_price_eur_kwh | float }}"
              active_billing_month: "{{ now().strftime('%Y-%m') }}"

          - repeat:
              sequence:
                - wait_template: >
                    {{
                      states(power_entity) != last_power_state
                      or
                      (
                        pricing_mode_var == 'dynamic'
                        and states(dynamic_price_entity) != last_price_state
                      )
                    }}
                  timeout:
                    minutes: !input calculation_interval
                  continue_on_timeout: true

                - variables:
                    now_ts: "{{ as_timestamp(now()) }}"

                    elapsed_hours: >
                      {{
                        [
                          (
                            (
                              as_timestamp(now())
                              - (last_sample_ts | float)
                            ) / 3600
                          ),
                          0
                        ] | max
                      }}

                    current_power_state: "{{ states(power_entity) }}"

                    current_power_unit: >
                      {{ state_attr(power_entity, 'unit_of_measurement') or '' }}

                    current_power_kw: >
                      {% set s = states(power_entity) %}
                      {% if not is_number(s) %}
                        -1
                      {% elif current_power_unit == 'W' %}
                        {{ (s | float) / 1000 }}
                      {% elif current_power_unit == 'kW' %}
                        {{ s | float }}
                      {% else %}
                        -1
                      {% endif %}

                    current_price_state: >
                      {% if pricing_mode_var == 'dynamic' %}
                        {{ states(dynamic_price_entity) }}
                      {% else %}
                        fixed
                      {% endif %}

                    current_price_unit: >
                      {% if pricing_mode_var == 'dynamic' %}
                        {{ state_attr(dynamic_price_entity, 'unit_of_measurement') or '' }}
                      {% else %}
                        EUR/kWh
                      {% endif %}

                    current_price_eur_kwh: >
                      {% if pricing_mode_var == 'fixed' %}
                        {{ fixed_price_var | float }}
                      {% elif not is_number(states(dynamic_price_entity)) %}
                        -1
                      {% elif current_price_unit in ['EUR/kWh', '€/kWh'] %}
                        {{ states(dynamic_price_entity) | float }}
                      {% elif current_price_unit in ['EUR/MWh', '€/MWh'] %}
                        {{ (states(dynamic_price_entity) | float) / 1000 }}
                      {% else %}
                        -1
                      {% endif %}

                    interval_cost: >
                      {% if
                        (last_power_kw | float(-1)) >= 0
                        and (last_price_eur_kwh | float(-1)) >= 0
                      %}
                        {{
                          (last_power_kw | float)
                          * (last_price_eur_kwh | float)
                          * (elapsed_hours | float)
                        }}
                      {% else %}
                        0
                      {% endif %}

                    existing_reimbursement: >
                      {{ states(reimbursement_entity) | float(0) }}

                    proposed_reimbursement: >
                      {{
                        (existing_reimbursement | float)
                        + (interval_cost | float)
                      }}

                    current_month: "{{ now().strftime('%Y-%m') }}"

                - if:
                    - condition: template
                      value_template: >
                        {{ current_month != active_billing_month }}
                  then:
                    - action: input_number.set_value
                      target:
                        entity_id: !input reimbursement_output
                      data:
                        value: 0

                    - action: input_text.set_value
                      target:
                        entity_id: !input billing_month_output
                      data:
                        value: "{{ current_month }}"

                    - variables:
                        existing_reimbursement: 0
                        proposed_reimbursement: "{{ interval_cost | float }}"
                        active_billing_month: "{{ current_month }}"

                - if:
                    - condition: template
                      value_template: >
                        {{
                          (proposed_reimbursement | float)
                          >
                          (
                            state_attr(reimbursement_entity, 'max')
                            | float(0)
                          )
                        }}
                  then:
                    - action: logbook.log
                      data:
                        name: Company EV Home Charging
                        message: >
                          Reimbursement helper maximum reached.

                    - stop: Reimbursement output maximum exceeded.
                      error: true

                - if:
                    - condition: template
                      value_template: >
                        {{
                          (last_power_kw | float(-1)) >= 0
                          and (last_price_eur_kwh | float(-1)) >= 0
                          and (interval_cost | float) > 0
                        }}
                  then:
                    - action: input_number.set_value
                      target:
                        entity_id: !input reimbursement_output
                      data:
                        value: "{{ proposed_reimbursement | float }}"

                - variables:
                    last_sample_ts: "{{ now_ts | float }}"
                    last_power_state: "{{ current_power_state }}"
                    last_power_kw: "{{ current_power_kw | float(-1) }}"
                    last_price_state: "{{ current_price_state }}"
                    last_price_eur_kwh: >
                      {{ current_price_eur_kwh | float(-1) }}

              until:
                - condition: template
                  value_template: >
                    {% set s = states(power_entity) %}

                    {% if not is_number(s) %}
                      false
                    {% else %}
                      {% set unit =
                        state_attr(power_entity, 'unit_of_measurement') or ''
                      %}

                      {% if unit == 'W' %}
                        {{
                          (s | float)
                          <= (charging_threshold_w | float)
                        }}
                      {% elif unit == 'kW' %}
                        {{
                          ((s | float) * 1000)
                          <= (charging_threshold_w | float)
                        }}
                      {% else %}
                        false
                      {% endif %}
                    {% endif %}

          - action: logbook.log
            data:
              name: Company EV Home Charging
              message: >
                Charging session finished.
                Current monthly reimbursement:
                €{{ states(reimbursement_entity) | float(0) | round(2) }}.


mode: single
max_exceeded: silent
