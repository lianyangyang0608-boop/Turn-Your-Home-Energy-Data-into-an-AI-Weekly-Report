blueprint:
  name: ecoMain AI Weekly Energy Report
  description: >
    Automatically generate a weekly AI energy report from ecoMain energy
    statistics in Home Assistant.

    Every Monday, this blueprint analyzes the previous complete Monday-Sunday
    period, compares it with the week before, and sends the data to a selected
    Home Assistant conversation agent.

    The report includes:
    - Weekly energy overview
    - Daily energy pattern
    - Circuit-level analysis
    - Week-on-week comparison
    - AI insights
    - Abnormal-use assessment
    - Practical recommendations

    Requirements:
    - ecoMain energy statistics available in Home Assistant
    - Long-term statistics enabled for the selected sensors
    - A configured Home Assistant conversation agent

  domain: automation

  input:

    main_energy:
      name: Total Energy Statistic
      description: >
        Select the ecoMain statistic representing total site or household
        forward energy consumption (main_all).
      selector:
        statistic:

    monitored_circuits:
      name: Monitored Circuit Statistics
      description: >
        Select the ecoMain circuit energy statistics you want included in the
        weekly circuit analysis. Select CH1, CH2, CH3, etc. as appropriate.
        Do not select temporary test loads unless you want them analyzed.
      selector:
        statistic:
          multiple: true

    ai_agent:
      name: AI Conversation Agent
      description: >
        Select the Home Assistant conversation agent that should generate
        the weekly energy report.
      selector:
        conversation_agent:

    report_time:
      name: Weekly Report Time
      description: >
        Time on Monday when the weekly report should be generated.
      default: "08:00:00"
      selector:
        time:

    site_name:
      name: Site Name
      description: >
        Optional name shown in the AI report, for example "Home",
        "Apartment" or "Demo House".
      default: "Home"
      selector:
        text:

    extra_context:
      name: Optional Energy Context
      description: >
        Optional context for the AI, such as known circuit identities.
        Example: "CH1 = heat pump, CH4 = EV charger".
        Leave blank if circuit identities are unknown.
      default: ""
      selector:
        text:
          multiline: true


# =========================================================
# Trigger: every day at selected time
# Condition below limits execution to Monday
# =========================================================

triggers:
  - trigger: time
    at: !input report_time

conditions:
  - condition: template
    value_template: "{{ now().weekday() == 0 }}"


# =========================================================
# Blueprint inputs exposed as template variables
# =========================================================

variables:

  main_stat: !input main_energy
  circuit_stats: !input monitored_circuits
  site_name_value: !input site_name
  extra_context_value: !input extra_context

  week_start: >
    {{ today_at("00:00") - timedelta(days=7) }}

  week_end: >
    {{ today_at("00:00") }}

  previous_week_start: >
    {{ today_at("00:00") - timedelta(days=14) }}

  previous_week_end: >
    {{ today_at("00:00") - timedelta(days=7) }}

  week_label: >
    {{
      (today_at("00:00") - timedelta(days=7)).strftime('%b %d')
    }} – {{
      (today_at("00:00") - timedelta(days=1)).strftime('%b %d, %Y')
    }}

  previous_week_label: >
    {{
      (today_at("00:00") - timedelta(days=14)).strftime('%b %d')
    }} – {{
      (today_at("00:00") - timedelta(days=8)).strftime('%b %d, %Y')
    }}


actions:

  # =======================================================
  # 1. Current-week total energy
  # =======================================================

  - action: recorder.get_statistics
    data:
      start_time: "{{ week_start }}"
      end_time: "{{ week_end }}"
      period: day
      statistic_ids:
        - !input main_energy
      types:
        - change
      units:
        energy: kWh
    response_variable: current_main_stats


  # =======================================================
  # 2. Previous-week total energy
  # =======================================================

  - action: recorder.get_statistics
    data:
      start_time: "{{ previous_week_start }}"
      end_time: "{{ previous_week_end }}"
      period: day
      statistic_ids:
        - !input main_energy
      types:
        - change
      units:
        energy: kWh
    response_variable: previous_main_stats


  # =======================================================
  # 3. Current-week circuit statistics
  # =======================================================

  - action: recorder.get_statistics
    data:
      start_time: "{{ week_start }}"
      end_time: "{{ week_end }}"
      period: day
      statistic_ids: !input monitored_circuits
      types:
        - change
      units:
        energy: kWh
    response_variable: current_circuit_stats


  # =======================================================
  # 4. Previous-week circuit statistics
  # =======================================================

  - action: recorder.get_statistics
    data:
      start_time: "{{ previous_week_start }}"
      end_time: "{{ previous_week_end }}"
      period: day
      statistic_ids: !input monitored_circuits
      types:
        - change
      units:
        energy: kWh
    response_variable: previous_circuit_stats


  # =======================================================
  # 5. Calculate deterministic site KPIs in Home Assistant
  # =======================================================

  - variables:

      current_total: >
        {{
          current_main_stats.statistics[main_stat]
          | map(attribute='change')
          | map('float')
          | sum
          | round(2)
        }}

      previous_total: >
        {{
          previous_main_stats.statistics[main_stat]
          | map(attribute='change')
          | map('float')
          | sum
          | round(2)
        }}

      daily_average: >
        {% set days = current_main_stats.statistics[main_stat] | length %}
        {% if days > 0 %}
          {{
            (
              current_main_stats.statistics[main_stat]
              | map(attribute='change')
              | map('float')
              | sum / days
            ) | round(2)
          }}
        {% else %}
          0
        {% endif %}

      wow_change: >
        {% set current = current_total | float %}
        {% set previous = previous_total | float %}
        {% if previous > 0 %}
          {{ (((current - previous) / previous) * 100) | round(1) }}
        {% else %}
          0
        {% endif %}


  # =======================================================
  # 6. AI analysis
  # =======================================================

  - action: conversation.process
    data:
      agent_id: !input ai_agent

      text: >
        You are an AI energy analyst for an ecoMain smart energy
        monitoring system.

        SITE:
        {{ site_name_value }}

        CURRENT WEEK:
        {{ week_label }}

        PREVIOUS WEEK:
        {{ previous_week_label }}

        HOME ASSISTANT CALCULATED VALUES:

        Current-week total:
        {{ current_total }} kWh

        Current-week daily average:
        {{ daily_average }} kWh/day

        Previous-week total:
        {{ previous_total }} kWh

        Week-on-week change:
        {{ wow_change }}%

        CURRENT-WEEK DAILY TOTAL ENERGY DATA:

        {{ current_main_stats }}

        CURRENT-WEEK CIRCUIT DATA:

        {{ current_circuit_stats }}

        PREVIOUS-WEEK CIRCUIT DATA:

        {{ previous_circuit_stats }}

        OPTIONAL USER CONTEXT:

        {{ extra_context_value }}

        RULES:

        - Use only the supplied energy data and optional user context.
        - Treat the Home Assistant calculated totals as authoritative.
        - Do not invent appliance identities.
        - Do not invent causes for changes in energy use.
        - High consumption does not automatically mean abnormal consumption.
        - Large week-on-week changes do not automatically indicate faults.
        - Do not diagnose meter, CT or sensor faults without sufficient evidence.
        - Do not assume the sum of monitored circuits must equal total energy.
        - Do not expose raw Home Assistant timestamps.
        - Do not expose raw statistics objects.
        - If evidence is insufficient, state:
          "No confirmed abnormal energy use was detected."

        Generate a concise weekly energy report with this structure:

        1. THIS WEEK AT A GLANCE
        - Total energy
        - Daily average
        - Highest-consumption day
        - Lowest-consumption day
        - Largest monitored circuit

        2. DAILY ENERGY
        - Show all seven days in a compact Date | kWh table
        - Add one short sentence describing the weekly pattern

        3. CIRCUIT BREAKDOWN
        - Rank active monitored circuits by weekly energy
        - Show Circuit | kWh | Share
        - Group zero-use circuits together
        - Add no more than two short observations

        4. WEEK-ON-WEEK
        - Current week
        - Previous week
        - Percentage change
        - Identify the two most meaningful circuit-level changes

        5. AI INSIGHTS
        Provide exactly three short insights:
        - current-week energy pattern
        - circuit-level pattern
        - week-on-week interpretation

        6. ABNORMAL USE
        One short paragraph only.

        7. RECOMMENDATIONS
        Provide exactly three concise, practical recommendations.

        Keep the report easy to scan.
        Prefer tables and bullets over long paragraphs.
        Write like a smart-energy product report, not a chatbot.

    response_variable: ai_report


  # =======================================================
  # 7. Show report in Home Assistant
  # =======================================================

  - action: persistent_notification.create
    data:
      title: >
        ecoMain Weekly Energy Report | {{ week_label }}
      message: >
        {{ ai_report.response.speech.plain.speech }}

mode: single
